---
// Política de privacidad por app. Contenido: content/apps/<slug>/privacidad.md
// URL contractual para Google Play / App Store: /<slug>/privacidad

import LegalLayout from '../../layouts/LegalLayout.astro';
import { getApp } from '../../utils/apps';

const docs = import.meta.glob<any>('/content/apps/*/privacidad.md', { eager: true });

export function getStaticPaths() {
  const paths = import.meta.glob('/content/apps/*/privacidad.md');
  return Object.keys(paths)
    .map((path) => path.split('/')[3])
    .filter((slug) => getApp(slug))
    .map((slug) => ({ params: { app: slug } }));
}

const { app } = Astro.params;
const { slug, meta } = getApp(app!)!;
const doc = docs[`/content/apps/${slug}/privacidad.md`];
const { Content } = doc;
const docTitle = doc.getHeadings().find((h: any) => h.depth === 1)?.text
  ?? `Política de Privacidad — ${meta.nombre}`;
---

<LegalLayout slug={slug} meta={meta} docTitle={docTitle} current="privacidad">
  <Content />
</LegalLayout>
