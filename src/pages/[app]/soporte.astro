---
// Página de soporte (Apple la pide como "Support URL" en App Store Connect).
// Contenido: content/apps/<slug>/soporte.md
// El archivo es OPCIONAL: las apps que no lo tienen no generan esta ruta (404).
// URL contractual: /<slug>/soporte

import LegalLayout from '../../layouts/LegalLayout.astro';
import { getApp } from '../../utils/apps';

const docs = import.meta.glob<any>('/content/apps/*/soporte.md', { eager: true });

export function getStaticPaths() {
  const paths = import.meta.glob('/content/apps/*/soporte.md');
  return Object.keys(paths)
    .map((path) => path.split('/')[3])
    .filter((slug) => getApp(slug))
    .map((slug) => ({ params: { app: slug } }));
}

const { app } = Astro.params;
const { slug, meta } = getApp(app!)!;
const doc = docs[`/content/apps/${slug}/soporte.md`];
const { Content } = doc;
const docTitle = doc.getHeadings().find((h: any) => h.depth === 1)?.text
  ?? `Soporte - ${meta.nombre}`;
---

<LegalLayout slug={slug} meta={meta} docTitle={docTitle} current="soporte">
  <Content />
</LegalLayout>
