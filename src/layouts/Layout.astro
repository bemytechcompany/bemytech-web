---
// Layout.astro - Global layout component
// Includes i18n configuration, SEO meta tags, fonts and global styles

import { getTranslationsForSSR, getLanguageClass } from '../utils/i18n';
import Nav from '../components/Nav.astro';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
  noIndex?: boolean;
}

// Language comes from the page (static routes: / = es, /en = en)
const lang = Astro.props.lang || 'es';

// Load translations for SSR
const { t } = await getTranslationsForSSR(lang);

// Props with defaults
const {
  title = `${t('hero.title')} ${t('hero.titleAccent')} | BEMYTECH`,
  description = t('hero.subtitle'),
  noIndex = false
} = Astro.props;

// Generate language class for CSS
const languageClass = getLanguageClass(lang);
---

<!doctype html>
<html lang={lang} class={languageClass}>
	<head>
    <!-- Essential Meta Tags -->
		<meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="desarrollo web, desarrollo móvil, consultoría IT, inteligencia artificial, soporte técnico, BEMYTECH, soluciones tecnológicas, Pereira, Colombia" />
    <meta name="author" content="BEMYTECH" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="BEMYTECH" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg" />

    <!-- Robots -->
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Theme Color -->
    <meta name="theme-color" content="#070A07" />
    <meta name="color-scheme" content="dark" />

    <!-- Fonts: Space Grotesk (display) + Inter (body) + JetBrains Mono (labels/code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Structured Data: local business + services -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": "https://bemytech.io/#organization",
      "name": "BEMYTECH",
      "legalName": "SOLUCIONES TECNOLÓGICAS BEMYTECH S.A.S.",
      "description": "Empresa de desarrollo de software a la medida en Pereira, Colombia. Aplicaciones web, móviles e inteligencia artificial.",
      "url": "https://bemytech.io",
      "logo": "https://bemytech.io/favicon.svg",
      "image": "https://bemytech.io/og-image.jpg",
      "telephone": "+57-311-430-2256",
      "email": "contacto@bemytech.io",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Pereira",
        "addressRegion": "Risaralda",
        "addressCountry": "CO"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 4.8133,
        "longitude": -75.6961
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "18:00"
      },
      "areaServed": ["Colombia", "Latinoamérica"],
      "knowsLanguage": ["es", "en"],
      "sameAs": [],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios de desarrollo de software",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Desarrollo web a la medida" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Desarrollo de aplicaciones móviles" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Inteligencia artificial aplicada" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cloud y DevOps" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Consultoría IT" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Soporte técnico" } }
        ]
      }
    }
    </script>

    <!-- Page-specific head content -->
    <slot name="head" />
	</head>

  <body class="font-sans text-base leading-relaxed text-white bg-primary overflow-x-hidden antialiased selection:bg-accent/30">

    <!-- Navigation -->
    <Nav lang={lang} />

    <!-- Main Content Container -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Custom cursor (activated by JS on fine pointers) -->
    <div id="bt-cursor-ring" aria-hidden="true"></div>
    <div id="bt-cursor-dot" aria-hidden="true"></div>

    <!-- Language Detection and Setup Script -->
    <script>
      (window as any).currentLanguage = document.documentElement.lang || 'es';

      if (typeof localStorage !== 'undefined') {
        localStorage.setItem('preferred-language', (window as any).currentLanguage);
      }
    </script>

    <!-- Global interactive FX: cursor, magnetic buttons, 3D tilt, easter eggs -->
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(pointer: fine)').matches;
      const isEn = document.documentElement.lang === 'en';

      // --- Custom cursor: dot follows instantly, ring trails with lerp ---
      if (finePointer && !reduceMotion) {
        const dot = document.getElementById('bt-cursor-dot');
        const ring = document.getElementById('bt-cursor-ring');

        if (dot && ring) {
          document.documentElement.classList.add('bt-cursor-on');

          let mx = -100, my = -100;
          let rx = -100, ry = -100;
          let visible = false;

          const place = (el: HTMLElement, x: number, y: number) => {
            el.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
          };

          window.addEventListener('pointermove', (e) => {
            mx = e.clientX;
            my = e.clientY;
            if (!visible) {
              visible = true;
              rx = mx; ry = my;
              dot.style.opacity = '1';
              ring.style.opacity = '1';
            }
          }, { passive: true });

          document.documentElement.addEventListener('mouseleave', () => {
            visible = false;
            dot.style.opacity = '0';
            ring.style.opacity = '0';
          });

          const loop = () => {
            rx += (mx - rx) * 0.16;
            ry += (my - ry) * 0.16;
            place(dot, mx, my);
            place(ring, rx, ry);
            requestAnimationFrame(loop);
          };
          requestAnimationFrame(loop);

          // Ring grows over interactive elements
          document.addEventListener('mouseover', (e) => {
            const target = (e.target as HTMLElement).closest('a, button, [role="button"], input, textarea, select');
            ring.classList.toggle('is-active', !!target);
          });
        }
      }

      // --- Magnetic pull on primary/secondary buttons ---
      if (finePointer && !reduceMotion) {
        document.querySelectorAll<HTMLElement>('.btn-primary, .btn-secondary').forEach((btn) => {
          btn.addEventListener('pointermove', (e) => {
            const r = btn.getBoundingClientRect();
            const dx = (e.clientX - (r.left + r.width / 2)) * 0.22;
            const dy = (e.clientY - (r.top + r.height / 2)) * 0.34;
            btn.style.transform = `translate(${dx}px, ${dy}px)`;
          });
          btn.addEventListener('pointerleave', () => {
            btn.style.transform = '';
          });
        });
      }

      // --- 3D tilt + cursor spotlight on cards ---
      if (finePointer && !reduceMotion) {
        document.querySelectorAll<HTMLElement>('.card-surface:not([data-no-tilt])').forEach((card) => {
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width;
            const py = (e.clientY - r.top) / r.height;
            card.style.setProperty('--mx', `${px * 100}%`);
            card.style.setProperty('--my', `${py * 100}%`);
            const rotX = (py - 0.5) * -5;
            const rotY = (px - 0.5) * 5;
            card.style.transform = `perspective(900px) rotateX(${rotX}deg) rotateY(${rotY}deg)`;
          });
          card.addEventListener('pointerleave', () => {
            card.style.transform = '';
          });
        });
      }

      // --- Tab title wink ---
      const originalTitle = document.title;
      document.addEventListener('visibilitychange', () => {
        document.title = document.hidden
          ? (isEn ? '👀 Your project misses you — BEMYTECH' : '👀 Tu proyecto te extraña — BEMYTECH')
          : originalTitle;
      });

      // --- Console easter egg for the devs ---
      console.log(
        '%c⬡ BEMYTECH %c\n\n' +
        (isEn
          ? 'Inspecting our code? We like you already.\nLet\'s build something → contacto@bemytech.io'
          : '¿Inspeccionando nuestro código? Ya nos caes bien.\nConstruyamos algo → contacto@bemytech.io'),
        'font-size: 22px; font-weight: bold; color: #82C232;',
        'font-size: 13px; color: #A4E84F; font-family: monospace;'
      );
    </script>

    <!-- Smooth Scrolling for anchor links -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const links = document.querySelectorAll('a[href^="#"]');

        links.forEach(link => {
          link.addEventListener('click', (e) => {
            e.preventDefault();

            const targetHref = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
            const target = document.querySelector(targetHref || '');
            if (target) {
              target.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
              });
            }
          });
        });
      });
    </script>
	</body>
</html>
<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  h1, h2, h3, h4, h5, h6 {
    @apply font-display font-bold leading-tight text-white;
  }

  p {
    @apply text-white/70 leading-relaxed;
  }

  a {
    @apply no-underline transition-all duration-300;
  }

  ::selection {
    @apply bg-accent/30 text-white;
  }

  ::-webkit-scrollbar {
    @apply w-2;
  }

  ::-webkit-scrollbar-track {
    @apply bg-bemytech-gray;
  }

  ::-webkit-scrollbar-thumb {
    @apply bg-accent/60 rounded;
  }

  ::-webkit-scrollbar-thumb:hover {
    @apply bg-accent;
  }

  :focus-visible {
    @apply outline-2 outline-accent outline-offset-2;
  }

  .sr-only {
    @apply absolute w-px h-px p-0 -m-px overflow-hidden whitespace-nowrap border-0;
    clip: rect(0, 0, 0, 0);
  }

  @media (hover: none) and (pointer: coarse) {
    * {
      cursor: auto !important;
    }
  }
</style>
