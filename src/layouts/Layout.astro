---
// Layout.astro - Global layout component
// Includes i18n configuration, SEO meta tags, fonts and global styles

import { getTranslationsForSSR, getLanguageClass } from '../utils/i18n';
import Nav from '../components/Nav.astro';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
  noIndex?: boolean;
}

// Language comes from the page (static routes: / = es, /en = en)
const lang = Astro.props.lang || 'es';

// Load translations for SSR
const { t } = await getTranslationsForSSR(lang);

// Props with defaults
const {
  title = `${t('hero.title')} ${t('hero.titleAccent')} | BEMYTECH`,
  description = t('hero.subtitle'),
  noIndex = false
} = Astro.props;

// Generate language class for CSS
const languageClass = getLanguageClass(lang);
---

<!doctype html>
<html lang={lang} class={languageClass}>
	<head>
    <!-- Essential Meta Tags -->
		<meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="desarrollo web, desarrollo móvil, consultoría IT, inteligencia artificial, soporte técnico, BEMYTECH, soluciones tecnológicas, Pereira, Colombia" />
    <meta name="author" content="BEMYTECH" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="BEMYTECH" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg" />

    <!-- Robots -->
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Theme Color -->
    <meta name="theme-color" content="#070A07" />
    <meta name="color-scheme" content="dark" />

    <!-- Fonts: Space Grotesk (display) + Inter (body) + JetBrains Mono (labels/code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "BEMYTECH",
      "description": "Soluciones tecnológicas innovadoras para el crecimiento de tu negocio",
      "url": "https://bemytech.io",
      "logo": "https://bemytech.io/favicon.svg",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Pereira",
        "addressCountry": "CO"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "telephone": "+57-311-430-2256",
        "email": "contacto@bemytech.com",
        "availableLanguage": ["Spanish", "English"]
      }
    }
    </script>

    <!-- Page-specific head content -->
    <slot name="head" />
	</head>

  <body class="font-sans text-base leading-relaxed text-white bg-primary overflow-x-hidden antialiased selection:bg-accent/30">

    <!-- Navigation -->
    <Nav lang={lang} />

    <!-- Main Content Container -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Language Detection and Setup Script -->
    <script>
      (window as any).currentLanguage = document.documentElement.lang || 'es';

      if (typeof localStorage !== 'undefined') {
        localStorage.setItem('preferred-language', (window as any).currentLanguage);
      }
    </script>

    <!-- Smooth Scrolling for anchor links -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const links = document.querySelectorAll('a[href^="#"]');

        links.forEach(link => {
          link.addEventListener('click', (e) => {
            e.preventDefault();

            const targetHref = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
            const target = document.querySelector(targetHref || '');
            if (target) {
              target.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
              });
            }
          });
        });
      });
    </script>
	</body>
</html>
<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  h1, h2, h3, h4, h5, h6 {
    @apply font-display font-bold leading-tight text-white;
  }

  p {
    @apply text-white/70 leading-relaxed;
  }

  a {
    @apply no-underline transition-all duration-300;
  }

  ::selection {
    @apply bg-accent/30 text-white;
  }

  ::-webkit-scrollbar {
    @apply w-2;
  }

  ::-webkit-scrollbar-track {
    @apply bg-bemytech-gray;
  }

  ::-webkit-scrollbar-thumb {
    @apply bg-accent/60 rounded;
  }

  ::-webkit-scrollbar-thumb:hover {
    @apply bg-accent;
  }

  :focus-visible {
    @apply outline-2 outline-accent outline-offset-2;
  }

  .sr-only {
    @apply absolute w-px h-px p-0 -m-px overflow-hidden whitespace-nowrap border-0;
    clip: rect(0, 0, 0, 0);
  }

  @media (hover: none) and (pointer: coarse) {
    * {
      cursor: auto !important;
    }
  }
</style>
