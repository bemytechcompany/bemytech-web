---
// Testimonials.astro - Client quotes + full-width CTA band
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;

const WHATSAPP_URL = 'https://wa.me/573114302256?text=Hola%20BEMYTECH%2C%20quiero%20comenzar%20mi%20proyecto';

const testimonials = ['testimonial1', 'testimonial2', 'testimonial3'];
---

<section id="testimonials" class="relative py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-x-0 top-0 mx-auto h-px max-w-site bg-gradient-to-r from-transparent via-accent/30 to-transparent" aria-hidden="true"></div>

  <div class="section-shell">
    <div class="reveal">
      <span class="section-label">{t('testimonials.label')}</span>
      <h2 class="section-title">{t('testimonials.title')}</h2>
      <p class="section-subtitle">{t('testimonials.subtitle')}</p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {testimonials.map((item, i) => (
        <figure class={`card-surface reveal reveal-delay-${i + 1} flex flex-col p-8`}>
          <svg class="h-8 w-8 text-accent/60" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9.583 17.321C8.553 16.227 8 15 8 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm-8 0C.553 16.227 0 15 0 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311C6.41 11.678 7.83 13.159 7.83 15a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z" />
          </svg>
          <blockquote class="mt-5 flex-1 text-sm leading-relaxed text-white/70">
            {t(`testimonials.${item}.text`)}
          </blockquote>
          <figcaption class="mt-6 border-t border-white/10 pt-5">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent/15 font-display text-base font-bold text-accent">
                {t(`testimonials.${item}.author`).charAt(0)}
              </span>
              <div class="min-w-0">
                <p class="font-display text-sm font-semibold text-white">
                  {t(`testimonials.${item}.author`)}
                  <span class="font-sans font-normal text-white/45"> · {t(`testimonials.${item}.role`)}</span>
                </p>
                <p class="truncate text-xs text-accent/90">{t(`testimonials.${item}.company`)}</p>
              </div>
            </div>
            <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.2em] text-white/35">
              {t(`testimonials.${item}.tag`)}
            </p>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- CTA band -->
    <div class="reveal relative mt-20 overflow-hidden rounded-3xl border border-accent/25 px-8 py-14 text-center sm:px-16">
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-accent/15 via-transparent to-accent/5" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -top-24 left-1/2 h-56 w-[36rem] -translate-x-1/2 rounded-full bg-accent/15 blur-[90px]" aria-hidden="true"></div>

      <h3 class="relative font-display text-2xl font-bold text-white sm:text-4xl">
        {t('testimonials.cta')}
      </h3>
      <p class="relative mx-auto mt-4 max-w-xl text-white/60">
        {t('testimonials.ctaSubtitle')}
      </p>
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary relative mt-8"
      >
        {t('testimonials.ctaButton')}
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
