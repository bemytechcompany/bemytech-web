---
// Technologies.astro - Dual-direction marquee of the stack
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;

const rowA = ['react', 'astro', 'nodejs', 'typescript', 'tailwind', 'gsap'];
const rowB = ['threejs', 'aws', 'docker', 'postgresql', 'mongodb', 'python'];

const itemsA = rowA.map((key) => ({ name: t(`technologies.${key}.name`), description: t(`technologies.${key}.description`) }));
const itemsB = rowB.map((key) => ({ name: t(`technologies.${key}.name`), description: t(`technologies.${key}.description`) }));
---

<section id="technologies" class="relative overflow-hidden py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-x-0 top-0 mx-auto h-px max-w-site bg-gradient-to-r from-transparent via-accent/30 to-transparent" aria-hidden="true"></div>

  <div class="section-shell">
    <div class="reveal">
      <span class="section-label">{t('technologies.label')}</span>
      <h2 class="section-title">{t('technologies.title')}</h2>
      <p class="section-subtitle">{t('technologies.subtitle')}</p>
    </div>
  </div>

  <div class="reveal mt-14 flex flex-col gap-5 [mask-image:linear-gradient(90deg,transparent,black_12%,black_88%,transparent)]">
    <!-- Row A -->
    <div class="group/row flex overflow-hidden">
      <div class="flex w-max animate-marquee gap-5 pr-5 group-hover/row:[animation-play-state:paused]">
        {[...itemsA, ...itemsA].map((tech) => (
          <div class="flex shrink-0 items-center gap-3 rounded-xl border border-white/[0.07] bg-surface/80 px-6 py-4 transition-colors duration-300 hover:border-accent/40" title={tech.description}>
            <span class="h-2 w-2 rounded-full bg-accent"></span>
            <span class="font-mono text-sm font-medium text-white">{tech.name}</span>
            <span class="hidden text-xs text-white/40 xl:block">{tech.description}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Row B (reverse) -->
    <div class="group/row flex overflow-hidden">
      <div class="flex w-max animate-marquee-reverse gap-5 pr-5 group-hover/row:[animation-play-state:paused]">
        {[...itemsB, ...itemsB].map((tech) => (
          <div class="flex shrink-0 items-center gap-3 rounded-xl border border-white/[0.07] bg-surface/80 px-6 py-4 transition-colors duration-300 hover:border-accent/40" title={tech.description}>
            <span class="h-2 w-2 rounded-full bg-accent-bright"></span>
            <span class="font-mono text-sm font-medium text-white">{tech.name}</span>
            <span class="hidden text-xs text-white/40 xl:block">{tech.description}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
