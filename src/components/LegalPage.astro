---
// LegalPage.astro - Shared layout for Privacy Policy and Terms & Conditions (es/en)
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { getTranslationsForSSR } from '../utils/i18n';
import { legal } from '../data/legal';

interface Props {
  lang: 'es' | 'en';
  type: 'privacy' | 'terms';
}

const { lang, type } = Astro.props;
const { t } = await getTranslationsForSSR(lang);
const doc = legal[type][lang];

const baseURL = Astro.site || 'http://localhost:4321';
const paths = {
  privacy: { es: '/privacy-policy', en: '/en/privacy-policy' },
  terms: { es: '/terms', en: '/en/terms' },
};
const canonicalURL = new URL(paths[type][lang], baseURL);
const altLang = lang === 'es' ? 'en' : 'es';
const altURL = paths[type][altLang];
const altLabel = lang === 'es' ? 'English version' : 'Versión en español';

const seoTitle = `${doc.title} | BEMYTECH`;
---

<Layout title={seoTitle} description={doc.intro} lang={lang}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={new URL(paths[type].es, baseURL)} />
    <link rel="alternate" hreflang="en" href={new URL(paths[type].en, baseURL)} />
  </Fragment>

  <section class="relative pt-36 pb-24">
    <div class="pointer-events-none absolute inset-0 bg-tech-grid" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-32 left-1/2 h-80 w-[50rem] -translate-x-1/2 rounded-full bg-accent/8 blur-[120px]" aria-hidden="true"></div>

    <div class="section-shell relative mx-auto !max-w-3xl">
      <span class="section-label">Legal</span>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-white sm:text-4xl">
        {doc.title}
      </h1>
      <div class="mt-5 flex flex-wrap items-center gap-4">
        <p class="font-mono text-xs text-white/40">{doc.updated}</p>
        <a href={altURL} class="font-mono text-xs text-accent underline-offset-4 hover:underline">
          {altLabel} →
        </a>
      </div>
      <p class="mt-6 text-base leading-relaxed text-white/65">{doc.intro}</p>

      <div class="mt-12 flex flex-col gap-10">
        {doc.sections.map((section) => (
          <section>
            <h2 class="font-display text-xl font-semibold text-accent">{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => (
              <p class="mt-3 text-sm leading-relaxed text-white/65">{paragraph}</p>
            ))}
            {section.items && (
              <ul class="mt-3 flex flex-col gap-2">
                {section.items.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-white/65">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70" aria-hidden="true"></span>
                    {item}
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>

      <div class="mt-14 border-t border-white/10 pt-8">
        <a href={lang === 'es' ? '/' : '/en'} class="btn-secondary">
          ← {lang === 'es' ? 'Volver al inicio' : 'Back to home'}
        </a>
      </div>
    </div>
  </section>

  <Footer t={t} lang={lang} />
</Layout>
