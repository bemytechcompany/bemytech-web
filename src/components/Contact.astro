---
// Contact.astro - Contact info + form that composes a WhatsApp message (no backend needed)
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;

const WHATSAPP_NUMBER = '573114302256';

const infoItems = [
  {
    label: t('contact.info.addressLabel'),
    value: t('contact.info.address'),
    icon: 'M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z',
  },
  {
    label: t('contact.info.phoneLabel'),
    value: t('contact.info.phone'),
    href: 'tel:+573114302256',
    icon: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z',
  },
  {
    label: t('contact.info.emailLabel'),
    value: t('contact.info.email'),
    href: 'mailto:contacto@bemytech.com',
    icon: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75',
  },
  {
    label: t('contact.info.hoursLabel'),
    value: t('contact.info.hours'),
    icon: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];
---

<section id="contact" class="relative py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-x-0 top-0 mx-auto h-px max-w-site bg-gradient-to-r from-transparent via-accent/30 to-transparent" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-0 left-1/2 h-72 w-[50rem] -translate-x-1/2 rounded-full bg-accent/5 blur-[120px]" aria-hidden="true"></div>

  <div class="section-shell relative">
    <div class="reveal">
      <span class="section-label">{t('contact.label')}</span>
      <h2 class="section-title">{t('contact.title')}</h2>
      <p class="section-subtitle">{t('contact.subtitle')}</p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <!-- Left: WhatsApp card + info -->
      <div class="reveal reveal-delay-1 flex flex-col gap-5">
        <div class="card-surface p-8 !border-accent/30">
          <div class="flex items-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#25D366]/15 text-[#25D366]">
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <h3 class="font-display text-xl font-semibold text-white">{t('contact.whatsapp.title')}</h3>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-white/60">{t('contact.whatsapp.text')}</p>
          <a
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%20BEMYTECH%2C%20quiero%20hablar%20sobre%20un%20proyecto`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary mt-6 w-full"
          >
            {t('contact.whatsapp.button')}
          </a>
        </div>

        <div class="card-surface grid gap-6 p-8 sm:grid-cols-2">
          {infoItems.map((item) => (
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
              <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/40">{item.label}</p>
                {item.href ? (
                  <a href={item.href} class="mt-1 block text-sm text-white/80 hover:text-accent">{item.value}</a>
                ) : (
                  <p class="mt-1 text-sm text-white/80">{item.value}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: form → WhatsApp -->
      <form id="contact-form" class="card-surface reveal reveal-delay-2 p-8" novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="cf-name" class="mb-2 block font-mono text-xs uppercase tracking-wider text-white/50">
              {t('contact.form.name')}
            </label>
            <input
              id="cf-name"
              name="name"
              type="text"
              required
              placeholder={t('contact.form.namePlaceholder')}
              class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder-white/30 outline-none transition-colors duration-300 focus:border-accent/60"
            />
          </div>
          <div>
            <label for="cf-company" class="mb-2 block font-mono text-xs uppercase tracking-wider text-white/50">
              {t('contact.form.company')}
            </label>
            <input
              id="cf-company"
              name="company"
              type="text"
              placeholder={t('contact.form.companyPlaceholder')}
              class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder-white/30 outline-none transition-colors duration-300 focus:border-accent/60"
            />
          </div>
        </div>

        <div class="mt-5">
          <label for="cf-email" class="mb-2 block font-mono text-xs uppercase tracking-wider text-white/50">
            {t('contact.form.email')}
          </label>
          <input
            id="cf-email"
            name="email"
            type="email"
            placeholder={t('contact.form.emailPlaceholder')}
            class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder-white/30 outline-none transition-colors duration-300 focus:border-accent/60"
          />
        </div>

        <div class="mt-5">
          <label for="cf-message" class="mb-2 block font-mono text-xs uppercase tracking-wider text-white/50">
            {t('contact.form.message')}
          </label>
          <textarea
            id="cf-message"
            name="message"
            rows="5"
            required
            placeholder={t('contact.form.messagePlaceholder')}
            class="w-full resize-none rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder-white/30 outline-none transition-colors duration-300 focus:border-accent/60"
          ></textarea>
        </div>

        <p id="cf-error" class="mt-3 hidden text-sm text-red-400">{t('contact.form.required')}</p>

        <button type="submit" class="btn-primary mt-6 w-full">
          {t('contact.form.send')}
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ WHATSAPP_NUMBER }}>
  // Compose the form fields into a prefilled WhatsApp message
  const form = document.getElementById('contact-form');
  const error = document.getElementById('cf-error');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const name = document.getElementById('cf-name')?.value.trim();
    const company = document.getElementById('cf-company')?.value.trim();
    const email = document.getElementById('cf-email')?.value.trim();
    const message = document.getElementById('cf-message')?.value.trim();

    if (!name || !message) {
      error?.classList.remove('hidden');
      return;
    }
    error?.classList.add('hidden');

    const lines = [
      `Hola BEMYTECH, soy ${name}.`,
      company ? `Empresa: ${company}` : null,
      email ? `Correo: ${email}` : null,
      '',
      message,
    ].filter((line) => line !== null);

    const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(url, '_blank', 'noopener');
  });
</script>
