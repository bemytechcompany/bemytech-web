---
// Portfolio.astro - Case-study grid of real shipped products
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;

// First two render large (featured), the rest in a 3-up row
const projects = [
  { key: 'project4', accent: 'from-accent/25' },   // Visual Emotion (AI) featured first
  { key: 'project5', accent: 'from-accent/15' },   // RikDrive
  { key: 'project2', accent: 'from-accent/10' },   // Castevo
  { key: 'project3', accent: 'from-accent/10' },   // Viatika
  { key: 'project1', accent: 'from-accent/10' },   // Raffle
];
---

<section id="portfolio" class="relative py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-x-0 top-0 mx-auto h-px max-w-site bg-gradient-to-r from-transparent via-accent/30 to-transparent" aria-hidden="true"></div>

  <div class="section-shell">
    <div class="reveal">
      <span class="section-label">{t('portfolio.label')}</span>
      <h2 class="section-title">{t('portfolio.title')}</h2>
      <p class="section-subtitle">{t('portfolio.subtitle')}</p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-6">
      {projects.map((project, i) => {
        const techs = t(`portfolio.${project.key}.tech`).split(',').map((s) => s.trim());
        const featured = i < 2;
        return (
          <article
            class={`card-surface reveal reveal-delay-${(i % 3) + 1} group flex flex-col p-8 ${featured ? 'lg:col-span-3' : 'lg:col-span-2'}`}
          >
            <!-- Corner gradient -->
            <div class={`pointer-events-none absolute right-0 top-0 h-40 w-40 rounded-bl-[6rem] bg-gradient-to-bl ${project.accent} to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100`} aria-hidden="true"></div>

            <!-- Index + category -->
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-accent">
                {t(`portfolio.${project.key}.category`)}
              </span>
              <span class="font-mono text-4xl font-bold text-white/[0.06] transition-colors duration-500 group-hover:text-accent/20">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>

            <h3 class={`font-display font-bold text-white transition-colors duration-300 group-hover:text-accent ${featured ? 'mt-4 text-3xl' : 'mt-3 text-2xl'}`}>
              {t(`portfolio.${project.key}.title`)}
            </h3>

            <p class="mt-4 flex-1 text-sm leading-relaxed text-white/60">
              {t(`portfolio.${project.key}.description`)}
            </p>

            <ul class="mt-6 flex flex-wrap gap-2" aria-label={t('portfolio.technologies')}>
              {techs.map((tech) => (
                <li class="rounded-md border border-white/10 bg-white/[0.03] px-2.5 py-1 font-mono text-[11px] text-white/70 transition-colors duration-300 group-hover:border-accent/30">
                  {tech}
                </li>
              ))}
            </ul>
          </article>
        );
      })}

      <!-- CTA tile completing the grid -->
      <a
        href="#contact"
        class="card-surface reveal reveal-delay-3 group flex flex-col items-start justify-between p-8 lg:col-span-2 hover:!border-accent/70"
      >
        <svg class="h-10 w-10 text-accent transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
        <div>
          <h3 class="font-display text-2xl font-bold text-white">
            {t('testimonials.cta')}
          </h3>
          <p class="mt-3 font-mono text-xs uppercase tracking-[0.2em] text-accent">
            {t('testimonials.ctaButton')} →
          </p>
        </div>
      </a>
    </div>
  </div>
</section>
