---

<section id="services" class="relative py-24 sm:py-32">
  <div class="section-shell">
    <div class="reveal">
      <span class="section-label">{t('services.label')}</span>
      <h2 class="section-title">{t('services.title')}</h2>
      <p class="section-subtitle">{t('services.subtitle')}</p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service, i) => (
        <article class={`card-surface reveal reveal-delay-${(i % 3) + 1} group p-7`}>
          <!-- hover glow -->
          <div class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-accent/0 blur-2xl transition-all duration-500 group-hover:bg-accent/15" aria-hidden="true"></div>

          <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-accent/25 bg-accent/10 text-accent transition-all duration-300 group-hover:scale-110 group-hover:bg-accent/20">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
            </svg>
          </div>

          <h3 class="mt-5 font-display text-xl font-semibold text-white">
            {t(`services.${service.key}.title`)}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-white/60">
            {t(`services.${service.key}.description`)}
          </p>
          <p class="mt-5 font-mono text-xs tracking-wide text-accent/80">
            {t(`services.${service.key}.tags`)}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
