---
// Nav.astro - Fixed top navigation with blur backdrop, language switcher and WhatsApp CTA
import { getTranslationsForSSR } from '../utils/i18n';

interface Props {
  lang?: 'es' | 'en';
}

const lang = Astro.props.lang || 'es';
const { t } = await getTranslationsForSSR(lang);
const homeHref = lang === 'es' ? '/' : '/en';

const WHATSAPP_URL = 'https://wa.me/573114302256?text=Hola%20BEMYTECH%2C%20quiero%20hablar%20sobre%20un%20proyecto';

const links = [
  { href: '#services', label: t('nav.services') },
  { href: '#process', label: t('nav.process') },
  { href: '#portfolio', label: t('nav.portfolio') },
  { href: '#testimonials', label: t('nav.testimonials') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-[100] transition-all duration-300"
>
  <div class="section-shell">
    <nav
      class="mt-3 flex items-center justify-between rounded-2xl border border-transparent px-4 py-3 transition-all duration-300"
      data-nav-bar
      aria-label="Main navigation"
    >
      <!-- Logo -->
      <a href={homeHref} class="group flex items-center gap-3" aria-label="BEMYTECH - Home">
        <svg width="30" height="35" viewBox="0 0 277 323" fill="none" xmlns="http://www.w3.org/2000/svg" class="transition-transform duration-300 group-hover:rotate-12">
          <path d="M235.792 64.6952C235.792 74.0125 236.024 83.3405 235.626 92.6405C235.528 94.8965 233.915 97.9712 232.044 99.1285C216.992 108.439 201.678 117.323 186.523 126.472C182.575 128.856 179.167 129.267 174.932 126.723C158.508 116.855 141.838 107.4 125.41 97.5378C123.762 96.5485 122.215 93.8512 122.192 91.9285C121.982 74.2098 122.115 56.4872 122.155 38.7672C122.164 34.3845 123.996 31.2592 127.918 28.9805C143.538 19.9005 159.071 10.6712 174.576 1.39383C177.774 -0.519506 180.516 -0.434175 183.723 1.47116C199.728 10.9778 215.798 20.3778 231.923 29.6778C234.836 31.3565 235.903 33.4565 235.847 36.7432C235.691 46.0592 235.792 55.3778 235.792 64.6952Z" fill="#82C232"/>
          <path d="M208.037 184.068C208.037 178.245 208.09 172.421 208.001 166.6C207.978 165.099 208.401 164.181 209.72 163.416C219.986 157.467 230.226 151.471 240.449 145.444C241.588 144.772 242.489 144.773 243.629 145.439C254.009 151.501 264.408 157.535 274.833 163.52C276.013 164.197 276.357 165 276.352 166.308C276.302 178.031 276.289 189.755 276.349 201.477C276.358 203.316 275.788 204.408 274.133 205.36C264.05 211.161 254.026 217.064 244.024 223.004C242.765 223.752 241.856 223.683 240.64 222.971C230.334 216.932 220.005 210.936 209.649 204.985C208.392 204.264 207.989 203.408 208.006 202.001C208.076 196.024 208.036 190.045 208.037 184.068Z" fill="#82C232"/>
          <path d="M0.0846877 204.581C0.0873544 190.888 0.211354 177.193 0.002021 163.502C-0.0513123 159.972 0.942021 157.814 4.04335 156.017C28.186 142.025 52.2674 127.926 76.3047 113.754C78.9847 112.173 81.1034 112.176 83.7847 113.743C108.195 127.999 132.649 142.185 157.163 156.261C159.938 157.853 160.746 159.742 160.734 162.816C160.619 190.385 160.587 217.954 160.727 245.523C160.749 249.845 159.407 252.413 155.518 254.651C131.807 268.293 108.233 282.174 84.7127 296.144C81.754 297.901 79.6127 297.741 76.754 296.065C52.5207 281.865 28.23 267.763 3.87669 253.772C0.919354 252.073 -0.025979 250.06 0.0126877 246.754C0.175354 232.698 0.082021 218.64 0.0846877 204.581Z" fill="#82C232"/>
          <path d="M166.164 299.499C166.166 296.066 166.196 292.634 166.144 289.202C166.131 288.317 166.379 287.777 167.156 287.326C173.208 283.818 179.244 280.285 185.27 276.731C185.942 276.335 186.472 276.337 187.146 276.729C193.264 280.302 199.394 283.858 205.539 287.387C206.234 287.786 206.436 288.259 206.434 289.03C206.404 295.941 206.398 302.851 206.432 309.762C206.438 310.845 206.102 311.489 205.126 312.05C199.183 315.469 193.274 318.949 187.378 322.45C186.636 322.891 186.099 322.851 185.383 322.431C179.308 318.871 173.219 315.337 167.115 311.83C166.374 311.403 166.136 310.899 166.147 310.07C166.187 306.547 166.164 303.023 166.164 299.499Z" fill="#82C232"/>
        </svg>
        <span class="font-display text-lg font-bold tracking-wide text-white">BEMY<span class="text-accent">TECH</span></span>
      </a>

      <!-- Desktop links -->
      <ul class="hidden items-center gap-7 lg:flex">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-mono text-[13px] uppercase tracking-wider text-white/60 transition-colors duration-300 hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Right side: lang switcher + CTA -->
      <div class="hidden items-center gap-4 lg:flex">
        <div class="flex items-center gap-1 font-mono text-xs">
          <a
            href="/"
            class={`rounded px-2 py-1 transition-colors duration-300 ${lang === 'es' ? 'bg-accent/15 text-accent' : 'text-white/40 hover:text-white'}`}
            aria-label="Cambiar a español"
          >ES</a>
          <a
            href="/en"
            class={`rounded px-2 py-1 transition-colors duration-300 ${lang === 'en' ? 'bg-accent/15 text-accent' : 'text-white/40 hover:text-white'}`}
            aria-label="Switch to English"
          >EN</a>
        </div>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn-primary !px-5 !py-2.5">
          {t('nav.letsTalk')}
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 text-white lg:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="h-5 w-5" data-icon-open fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="hidden h-5 w-5" data-icon-close fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="pointer-events-none mx-5 mt-2 origin-top scale-y-95 rounded-2xl border border-white/10 bg-bemytech-dark/95 p-6 opacity-0 backdrop-blur-xl transition-all duration-300 lg:hidden"
  >
    <ul class="flex flex-col gap-4">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link block font-display text-lg font-semibold text-white/80 transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-5">
      <div class="flex items-center gap-1 font-mono text-xs">
        <a href="/" class={`rounded px-2 py-1 ${lang === 'es' ? 'bg-accent/15 text-accent' : 'text-white/40'}`}>ES</a>
        <a href="/en" class={`rounded px-2 py-1 ${lang === 'en' ? 'bg-accent/15 text-accent' : 'text-white/40'}`}>EN</a>
      </div>
      <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn-primary !px-5 !py-2.5">
        {t('nav.letsTalk')}
      </a>
    </div>
  </div>
</header>

<script>
  // Nav background on scroll
  const navBar = document.querySelector('[data-nav-bar]');
  const onScroll = () => {
    if (!navBar) return;
    const scrolled = window.scrollY > 24;
    navBar.classList.toggle('bg-bemytech-dark/80', scrolled);
    navBar.classList.toggle('backdrop-blur-xl', scrolled);
    navBar.classList.toggle('border-white/10', scrolled);
    navBar.classList.toggle('border-transparent', !scrolled);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = toggle?.querySelector('[data-icon-open]');
  const iconClose = toggle?.querySelector('[data-icon-close]');

  function setMenu(open: boolean) {
    if (!menu || !toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('opacity-0', !open);
    menu.classList.toggle('scale-y-95', !open);
    menu.classList.toggle('pointer-events-none', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setMenu(open);
  });

  // Close menu when a link is tapped
  menu?.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>
