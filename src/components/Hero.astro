---
// Hero.astro - Full-viewport hero: headline + CTAs + stats, animated deploy terminal
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;

const WHATSAPP_URL = 'https://wa.me/573114302256?text=Hola%20BEMYTECH%2C%20quiero%20hablar%20sobre%20un%20proyecto';

const terminalLines = [
  { text: t('hero.terminal.line1'), cls: 'text-white' },
  { text: t('hero.terminal.line2'), cls: 'text-accent' },
  { text: t('hero.terminal.line3'), cls: 'text-accent' },
  { text: t('hero.terminal.line4'), cls: 'text-accent' },
  { text: t('hero.terminal.line5'), cls: 'text-accent' },
  { text: t('hero.terminal.line6'), cls: 'text-accent-bright font-semibold' },
];

const stats = [
  { value: t('hero.stats.yearsValue'), label: t('hero.stats.years') },
  { value: t('hero.stats.productsValue'), label: t('hero.stats.products') },
  { value: t('hero.stats.techsValue'), label: t('hero.stats.techs') },
];
---

<section id="hero" class="relative flex min-h-screen items-center overflow-hidden pt-28 pb-16">
  <!-- Background: grid + radial glows + floating hexagons -->
  <div class="pointer-events-none absolute inset-0 bg-tech-grid" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 h-[34rem] w-[60rem] -translate-x-1/2 rounded-full bg-accent/10 blur-[140px]"></div>
    <div class="absolute bottom-0 right-0 h-80 w-80 rounded-full bg-accent/5 blur-[100px]"></div>
    <!-- Decorative hexagons -->
    <svg class="absolute right-[8%] top-[18%] h-16 w-16 animate-float-slow text-accent/20" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
      <polygon points="50,3 95,27 95,73 50,97 5,73 5,27" />
    </svg>
    <svg class="absolute left-[6%] bottom-[22%] h-10 w-10 animate-float-slow text-accent/15 [animation-delay:1.5s]" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
      <polygon points="50,3 95,27 95,73 50,97 5,73 5,27" />
    </svg>
    <svg class="absolute left-[42%] top-[12%] h-6 w-6 animate-float-slow text-accent/25 [animation-delay:2.6s]" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="6" aria-hidden="true">
      <polygon points="50,3 95,27 95,73 50,97 5,73 5,27" />
    </svg>
  </div>

  <div class="section-shell relative z-10">
    <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr]">
      <!-- Left: copy -->
      <div>
        <p class="reveal inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/5 px-4 py-1.5 font-mono text-xs tracking-wider text-accent">
          <span class="h-1.5 w-1.5 animate-pulse-dot rounded-full bg-accent"></span>
          {t('hero.badge')}
        </p>

        <h1 class="reveal reveal-delay-1 mt-6 font-display text-4xl font-bold leading-[1.08] text-white sm:text-5xl xl:text-6xl">
          {t('hero.title')}
          <span class="text-glow-accent block">{t('hero.titleAccent')}</span>
        </h1>

        <p class="reveal reveal-delay-2 mt-6 max-w-xl text-lg leading-relaxed text-white/65">
          {t('hero.subtitle')}
        </p>

        <div class="reveal reveal-delay-3 mt-9 flex flex-wrap items-center gap-4">
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
            {t('hero.cta')}
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#portfolio" class="btn-secondary">
            {t('hero.ctaSecondary')}
          </a>
        </div>

        <!-- Stats -->
        <dl class="reveal reveal-delay-4 mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-white/10 pt-8">
          {stats.map((stat) => (
            <div>
              <dd class="font-display text-3xl font-bold text-accent sm:text-4xl">{stat.value}</dd>
              <dt class="mt-1 text-xs leading-snug text-white/50 sm:text-sm">{stat.label}</dt>
            </div>
          ))}
        </dl>
      </div>

      <!-- Right: animated deploy terminal -->
      <div class="reveal reveal-delay-2 relative hidden lg:block">
        <div class="absolute -inset-6 rounded-3xl bg-accent/10 blur-3xl" aria-hidden="true"></div>
        <div class="relative rounded-2xl border border-white/10 bg-[#0A0E0A]/95 shadow-2xl shadow-black/60 backdrop-blur">
          <!-- Title bar -->
          <div class="flex items-center gap-2 border-b border-white/[0.07] px-5 py-3.5">
            <span class="h-3 w-3 rounded-full bg-[#FF5F57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#FEBC2E]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28C840]"></span>
            <span class="ml-3 font-mono text-xs text-white/40">{t('hero.terminal.title')}</span>
          </div>
          <!-- Body -->
          <div id="hero-terminal" class="min-h-[16.5rem] px-6 py-5 font-mono text-sm leading-8">
            {terminalLines.map((line, i) => (
              <p class={`terminal-line opacity-0 ${line.cls}`} data-line={i}>{line.text}</p>
            ))}
            <p class="terminal-cursor mt-1 text-accent opacity-0">
              <span class="inline-block h-4 w-2 animate-pulse-dot bg-accent align-middle"></span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <a
    href="#services"
    class="absolute bottom-7 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 font-mono text-[11px] uppercase tracking-[0.3em] text-white/35 transition-colors hover:text-accent md:flex"
    aria-label={t('hero.scrollText')}
  >
    {t('hero.scrollText')}
    <svg class="h-4 w-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </a>
</section>

<style>
  .terminal-line {
    transition: opacity 0.3s ease, transform 0.3s ease;
    transform: translateY(6px);
  }

  .terminal-line.shown {
    opacity: 1;
    transform: translateY(0);
  }

  .terminal-cursor.shown {
    opacity: 1;
  }
</style>

<script>
  // Reveal terminal lines one by one once the hero is on screen
  const terminal = document.getElementById('hero-terminal');

  if (terminal) {
    const lines = terminal.querySelectorAll<HTMLElement>('.terminal-line');
    const cursor = terminal.querySelector<HTMLElement>('.terminal-cursor');
    let played = false;

    const play = () => {
      if (played) return;
      played = true;
      lines.forEach((line, i) => {
        setTimeout(() => {
          line.classList.add('shown');
          if (i === lines.length - 1) {
            setTimeout(() => cursor?.classList.add('shown'), 400);
          }
        }, 600 + i * 520);
      });
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      lines.forEach((line) => line.classList.add('shown'));
      cursor?.classList.add('shown');
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            play();
            observer.disconnect();
          }
        },
        { threshold: 0.3 }
      );
      observer.observe(terminal);
    }
  }
</script>
